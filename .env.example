

# Transporte SMTP genérico
SMTP_HOST=
SMTP_PORT=587
# false para STARTTLS (587); true para TLS direto (465)
SMTP_SECURE=false
# Use false apenas para um relay local sem TLS
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# Endereço autorizado pelo provedor, opcionalmente Nome <email@dominio>
SMTP_FROM=
